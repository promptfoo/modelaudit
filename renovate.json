{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["local>promptfoo/renovate-config"],
  "packageRules": [
    {
      "description": "Keep filelock updates above the affected releases even when Renovate reads the Python 3.10 lock for both markers.",
      "matchFileNames": ["pyproject.toml"],
      "matchManagers": ["pep621"],
      "matchPackageNames": ["filelock"],
      "allowedVersions": ">=4.2.9"
    },
    {
      "description": "Check Requires-Python when updating the Python 3.10 filelock pin.",
      "matchFileNames": ["pyproject.toml"],
      "matchManagers": ["pep621"],
      "matchPackageNames": ["filelock"],
      "matchCurrentValue": "/^==/",
      "constraints": { "python": "3.10" },
      "constraintsFiltering": "strict"
    },
    {
      "description": "Keep NumPy 1.x constraints on Python 3.10 markers in pyproject.toml.",
      "matchFileNames": ["pyproject.toml"],
      "matchManagers": ["pep621"],
      "matchPackageNames": ["numpy"],
      "matchCurrentValue": "/<2\\.0/",
      "allowedVersions": "<2.0"
    },
    {
      "description": "Keep NumPy 2.4.x constraints on Python 3.11 markers in pyproject.toml.",
      "matchFileNames": ["pyproject.toml"],
      "matchManagers": ["pep621"],
      "matchPackageNames": ["numpy"],
      "matchCurrentValue": "/<2\\.5/",
      "allowedVersions": "<2.5"
    },
    {
      "description": "Keep XGBoost 3.2.x constraints on Python 3.10 and 3.11 markers in pyproject.toml.",
      "matchFileNames": ["pyproject.toml"],
      "matchManagers": ["pep621"],
      "matchPackageNames": ["xgboost"],
      "matchCurrentValue": "/<3\\.3/",
      "allowedVersions": "<3.3"
    },
    {
      "description": "Keep Python updates within the project's supported range.",
      "matchPackageNames": ["python"],
      "allowedVersions": "<3.16"
    },
    {
      "description": "Keep the full image on Python 3.13 while its TensorFlow release lacks Python 3.14 wheels.",
      "matchFileNames": ["Dockerfile.full"],
      "matchPackageNames": ["python"],
      "allowedVersions": "<3.14"
    },
    {
      "description": "Keep the TensorFlow image on a runtime supported by the tensorflow extra.",
      "matchFileNames": ["Dockerfile.tensorflow"],
      "matchPackageNames": ["python"],
      "allowedVersions": "<3.13"
    }
  ],
  "vulnerabilityAlerts": {
    "labels": ["security"],
    "vulnerabilityFixStrategy": "lowest"
  }
}
